# Garage (self-hosted S3-compatible object store) config, mounted read-only into the
# garage container at /etc/garage.toml by docker-compose.prod.yml.
#
# scripts/vps-setup.sh downloads this file and fills in __RPC_SECRET__/__ADMIN_TOKEN__
# with freshly generated random values automatically — you shouldn't need to edit this
# by hand unless the cluster topology itself changes (e.g. adding a second node).

metadata_dir = "/data/meta"
data_dir = "/data/data"
db_engine = "lmdb"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "garage:3901"
rpc_secret = "__RPC_SECRET__"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "__ADMIN_TOKEN__"
